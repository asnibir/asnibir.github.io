---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import TagList from '../components/TagList.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';

// Fetch structured data from content collections
const publications = await getCollection('publications');
publications.sort((a, b) => (a.data.order ?? 1) - (b.data.order ?? 1));

const projects = await getCollection('projects');
projects.sort((a, b) => (a.data.order ?? 1) - (b.data.order ?? 1));

const experiences = await getCollection('experience');
experiences.sort((a, b) => (a.data.order ?? 1) - (b.data.order ?? 1));

const certifications = await getCollection('certifications');
certifications.sort((a, b) => (a.data.order ?? 1) - (b.data.order ?? 1));

// Research Interests chip list
const researchInterests = [
  'Multi-Agent Reinforcement Learning',
  'UAV Networks',
  'Wireless Power Transfer',
  'Deep Learning',
  'Energy-Efficient & Fair Resource Allocation',
];

// Grouped skills
const skillGroups = [
  {
    category: 'Languages',
    skills: ['C', 'C++', 'Python', 'JavaScript', 'TypeScript', 'Java'],
  },
  {
    category: 'Frontend',
    skills: ['Angular', 'HTML/CSS', 'NgRx', 'PrimeNG'],
  },
  {
    category: 'Research & AI',
    skills: ['TensorFlow', 'LaTeX (Overleaf)'],
  },
  {
    category: 'Tools & Platforms',
    skills: ['Git', 'Postman', 'Bold Reports'],
  },
];

// Competitive programming profiles
const competitiveProfiles = [
  {
    platform: 'LeetCode',
    username: 'AbuNibir',
    url: 'https://leetcode.com/AbuNibir/',
  },
  {
    platform: 'Codeforces',
    username: 'nibir.24csedu.003',
    url: 'https://codeforces.com/profile/nibir.24csedu.003',
  },
  {
    platform: 'LightOJ',
    username: 'nibir-24csed',
    // TODO: Verify or update this LightOJ URL
    url: 'https://lightoj.com/user/nibir-24csed',
  },
];
---

<BaseLayout>
  <!-- 1. HERO SECTION -->
  <Hero />

  <!-- 2. ABOUT SECTION -->
  <Section id="about" number="01" title="About">
    <!-- DRAFT COPY: Abu Shaikh Nibir can edit this text below -->
    <div class="space-y-4 text-sm sm:text-base text-stone-700 dark:text-stone-300 leading-relaxed font-sans">
      <p>
        I am a researcher and software engineer specializing in multi-agent reinforcement learning (MADRL) and wireless networks. During my undergraduate studies at the University of Dhaka, my research focused on optimizing trajectory coordination, scheduling, and weighted fair energy transfer in multi-UAV networks—work published in <a href="#publications" class="text-teal-700 dark:text-teal-400 font-medium underline decoration-teal-500/40 hover:decoration-teal-500"><em>Energy</em> (Elsevier, 2024)</a>. I am passionate about formulating principled learning algorithms that tackle real-world resource allocation, autonomous decision-making, and cyber-physical systems.
      </p>
      <p>
        In industry, I serve as a Frontend Software Engineer at Dohatec New Media, where I contribute to the architectural development of the National e-Project Management Information System (e-PMIS), building modular, reactive interfaces with Angular, NgRx, and TypeScript. Combining rigorous algorithmic foundations with large-scale production software engineering, I am currently preparing for and actively seeking <strong>PhD opportunities in Computer Science</strong> starting Fall 2025/2026 to pursue high-impact research in autonomous multi-agent systems and deep reinforcement learning.
      </p>
    </div>
  </Section>

  <!-- 3. RESEARCH INTERESTS SECTION -->
  <Section id="research" number="02" title="Research Interests">
    <div class="space-y-3">
      <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400">
        Primary research domains and theoretical methodologies of interest:
      </p>
      <!-- Compact tag/chip list -->
      <TagList tags={researchInterests} variant="accent" />
    </div>
  </Section>

  <!-- 4. PUBLICATIONS SECTION -->
  <Section id="publications" number="03" title="Publications">
    <div class="space-y-4">
      {publications.map((pub) => (
        <PublicationCard publication={pub} />
      ))}
    </div>
  </Section>

  <!-- 5. EDUCATION SECTION -->
  <Section id="education" number="04" title="Education">
    <div class="p-5 rounded-lg border border-stone-200/90 dark:border-stone-800/90 bg-stone-50/50 dark:bg-stone-900/40 space-y-3">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
        <div>
          <h3 class="text-base sm:text-lg font-semibold text-stone-900 dark:text-stone-100">
            University of Dhaka
          </h3>
          <p class="text-sm font-medium text-teal-700 dark:text-teal-300">
            Bachelor of Science in Computer Science and Engineering (CSE)
          </p>
        </div>
        <div class="text-left sm:text-right font-mono text-xs text-stone-500 dark:text-stone-400 shrink-0">
          <div>Jan 2018 — Dec 2022</div>
          <div>Dhaka, Bangladesh</div>
        </div>
      </div>

      <div class="text-xs sm:text-sm text-stone-700 dark:text-stone-300 space-y-1 font-mono">
        <div>
          <span class="text-stone-500 dark:text-stone-400">CGPA:</span>
          <span class="font-bold text-stone-900 dark:text-stone-100"> 3.48 / 4.00</span>
        </div>
        <div class="pt-1 font-sans text-xs sm:text-sm">
          <span class="font-mono text-xs font-semibold text-teal-700 dark:text-teal-300">Thesis / Research:</span>
          <span> UAV wireless power transfer with MADRL &mdash; </span>
          <a
            href="#publications"
            class="text-teal-600 dark:text-teal-400 hover:underline underline-offset-2 font-medium"
          >
            view published paper &rarr;
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- 6. RESEARCH & ACADEMIC PROJECTS SECTION -->
  <Section id="projects" number="05" title="Research & Academic Projects">
    <div class="space-y-4">
      {projects.map((proj) => (
        <ProjectCard project={proj} />
      ))}
    </div>
  </Section>

  <!-- 7. WORK EXPERIENCE SECTION -->
  <Section id="experience" number="06" title="Work Experience">
    <div class="space-y-4">
      {experiences.map((exp) => (
        <ExperienceItem experience={exp} />
      ))}
    </div>
  </Section>

  <!-- 8. SKILLS SECTION -->
  <Section id="skills" number="07" title="Skills">
    <div class="space-y-6">
      <!-- Grouped Skills List -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {skillGroups.map((group) => (
          <div class="p-4 rounded-lg border border-stone-200/90 dark:border-stone-800/90 bg-stone-50/50 dark:bg-stone-900/40 space-y-2">
            <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-teal-700 dark:text-teal-300">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {group.skills.map((skill) => (
                <span class="font-mono text-xs px-2 py-0.5 rounded bg-stone-100 dark:bg-stone-800 text-stone-800 dark:text-stone-200 border border-stone-200/60 dark:border-stone-700/60">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Competitive Programming Profiles -->
      <div class="pt-2 border-t border-stone-200/60 dark:border-stone-800/60">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-3">
          Competitive Programming Profiles
        </h3>
        <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
          {competitiveProfiles.map((cp) => (
            <a
              href={cp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md border border-stone-200 dark:border-stone-800 bg-stone-100/60 dark:bg-stone-900/60 text-stone-700 dark:text-stone-300 hover:text-teal-600 dark:hover:text-teal-400 hover:border-teal-500/50 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500"
            >
              <span class="font-semibold">{cp.platform}:</span>
              <span class="text-stone-500 dark:text-stone-400">{cp.username}</span>
              <svg class="w-3 h-3 ml-0.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </Section>

  <!-- 9. CERTIFICATIONS & LANGUAGES SECTION -->
  <Section id="certifications" number="08" title="Certifications & Languages">
    <div class="space-y-6">
      <!-- Language Proficiency -->
      <div class="p-4 rounded-lg border border-stone-200/90 dark:border-stone-800/90 bg-stone-50/50 dark:bg-stone-900/40">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-1">
          Language Proficiency
        </h3>
        <p class="text-xs sm:text-sm text-stone-800 dark:text-stone-200">
          <strong class="font-semibold">English:</strong> IELTS Academic &mdash; <span class="font-mono font-bold text-teal-700 dark:text-teal-300">Overall Band 7.5</span>
          <!-- TODO: Add test date and L/R/W/S sub-scores when ready (e.g., Listening: X, Reading: Y, Writing: Z, Speaking: W) -->
          <span class="text-xs font-mono text-stone-400 dark:text-stone-500 ml-1.5">(Sub-scores &amp; date: TODO)</span>
        </p>
      </div>

      <!-- Certifications Minimal List -->
      <div class="space-y-2">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400 mb-2">
          Specializations &amp; Certifications
        </h3>
        <ul class="space-y-2 font-mono text-xs sm:text-sm">
          {certifications.map((cert) => (
            <li class="flex flex-col sm:flex-row sm:items-center justify-between py-2 border-b border-stone-200/60 dark:border-stone-800/60 last:border-b-0 gap-1">
              <div>
                <span class="font-semibold text-stone-900 dark:text-stone-100">{cert.data.title}</span>
                <span class="text-stone-500 dark:text-stone-400"> &mdash; {cert.data.provider}</span>
              </div>
              <div class="flex items-center gap-2 text-stone-500 dark:text-stone-400 shrink-0">
                <span>· {cert.data.year}</span>
                <span>·</span>
                {cert.data.verifyUrl ? (
                  <a
                    href={cert.data.verifyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-teal-600 dark:text-teal-400 hover:underline underline-offset-2 inline-flex items-center gap-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500 rounded"
                    title={`Verify ${cert.data.title}`}
                  >
                    <span>[Verify]</span>
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ) : (
                  <span>[Verify: TODO]</span>
                )}
              </div>
            </li>
          ))}
        </ul>

        <!-- Subtle link to all certificates in Google Drive -->
        <!-- TODO: Replace href with actual Google Drive folder link -->
        <div class="pt-3">
          <a
            href="https://drive.google.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-stone-500 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 inline-flex items-center gap-1 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500 rounded"
          >
            <span>All certificates &rarr;</span>
            <span class="text-stone-400 dark:text-stone-500 text-[11px]">(Google Drive folder &mdash; TODO: set link)</span>
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- 10. CONTACT SECTION -->
  <Section id="contact" number="09" title="Contact">
    <div class="p-6 rounded-lg border border-teal-500/30 dark:border-teal-500/20 bg-teal-50/30 dark:bg-teal-950/20 space-y-4">
      <div>
        <p class="text-sm sm:text-base font-medium text-stone-900 dark:text-stone-100">
          Open to PhD opportunities and research collaborations.
        </p>
        <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 mt-1">
          Feel free to reach out for research inquiries, paper discussions, or potential advising opportunities.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <!-- Direct Email mailto link -->
        <a
          href="mailto:abushaikhnibir@gmail.com"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-md bg-teal-600 text-white dark:bg-teal-500 dark:text-stone-950 font-mono text-xs font-semibold hover:bg-teal-700 dark:hover:bg-teal-400 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>abushaikhnibir@gmail.com</span>
        </a>

        <!-- GitHub Profile link -->
        <a
          href="https://github.com/asnibir"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:text-stone-900 dark:hover:text-stone-100 hover:border-teal-500 font-mono text-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>GitHub</span>
        </a>

        <!-- LinkedIn Profile link -->
        <a
          href="https://www.linkedin.com/in/abu-shaikh-nibir/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:text-stone-900 dark:hover:text-stone-100 hover:border-teal-500 font-mono text-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
          <span>LinkedIn</span>
        </a>

        <!-- Google Scholar link (TODO) -->
        <a
          href="https://scholar.google.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:text-stone-900 dark:hover:text-stone-100 hover:border-teal-500 font-mono text-xs transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500"
          title="Google Scholar (TODO: update profile link)"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z" />
          </svg>
          <span>Scholar</span>
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
