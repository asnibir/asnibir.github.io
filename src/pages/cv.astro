---
// src/pages/cv.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Curriculum Vitae | Abu Shaikh Nibir"
  description="Curriculum Vitae of Abu Shaikh Nibir — Researcher & Frontend Software Engineer."
  canonicalUrl="https://asnibir.github.io/cv"
>
  <div class="py-6 sm:py-8 space-y-4">
    <!-- Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-lg border border-stone-200/90 dark:border-stone-800/90 bg-stone-50/70 dark:bg-stone-900/50">
      <div class="flex items-center gap-2">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-mono text-stone-600 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500 rounded py-0.5 px-1"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to Portfolio</span>
        </a>
        <span class="text-stone-300 dark:text-stone-700 select-none">|</span>
        <span class="font-mono text-xs sm:text-sm font-semibold text-teal-700 dark:text-teal-300">
          cv.pdf
        </span>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/cv.pdf"
          download="Abu_Shaikh_Nibir_CV.pdf"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-md bg-teal-600 text-white dark:bg-teal-500 dark:text-stone-950 font-mono text-xs sm:text-sm font-semibold hover:bg-teal-700 dark:hover:bg-teal-400 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Download CV</span>
        </a>

        <a
          href="/cv.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-md border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:text-stone-900 dark:hover:text-stone-100 font-mono text-xs sm:text-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>Open Fullscreen</span>
        </a>
      </div>
    </div>

    <!-- Embedded Viewer Container -->
    <div class="w-full h-[78vh] rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-100 dark:bg-stone-950 overflow-hidden shadow-sm">
      <object
        data="/cv.pdf#toolbar=1&navpanes=0"
        type="application/pdf"
        class="w-full h-full"
        title="Abu Shaikh Nibir CV Preview"
      >
        <iframe
          src="/cv.pdf#toolbar=1&navpanes=0"
          class="w-full h-full border-0"
          title="Abu Shaikh Nibir CV Preview"
        >
          <div class="h-full flex flex-col items-center justify-center p-8 text-center space-y-4">
            <p class="text-sm sm:text-base font-sans text-stone-700 dark:text-stone-300 max-w-md">
              Your browser does not support inline PDF viewing.
            </p>
            <a
              href="/cv.pdf"
              download="Abu_Shaikh_Nibir_CV.pdf"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-teal-600 text-white font-mono text-xs sm:text-sm font-semibold hover:bg-teal-700 transition-colors"
            >
              <span>Download CV (PDF)</span>
            </a>
          </div>
        </iframe>
      </object>
    </div>
  </div>
</BaseLayout>

