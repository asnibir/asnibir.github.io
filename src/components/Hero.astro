---
// Hero.astro
---

<section id="hero" class="pt-12 pb-10 sm:pt-16 sm:pb-14 border-b border-stone-200/70 dark:border-stone-800/70">
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8">
    <!-- Profile Photo (Placeholder: replace public/images/profile.jpg with real photo) -->
    <div class="relative shrink-0">
      <img
        src="/images/profile.png"
        alt="Abu Shaikh Nibir"
        width="136"
        height="136"
        class="w-32 h-32 sm:w-36 sm:h-36 rounded-full object-cover border-2 border-teal-500/30 dark:border-teal-400/30 shadow-md ring-4 ring-stone-200/50 dark:ring-stone-800/50"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Active status indicator dot -->
      <span
        class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-teal-500 border-2 border-stone-50 dark:border-stone-900"
        title="Active / Seeking PhD opportunities"
        aria-hidden="true"
      ></span>
    </div>

    <!-- Personal Intro & Details -->
    <div class="flex-1 text-center sm:text-left space-y-3.5">
      <div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-mono font-bold tracking-tight text-stone-900 dark:text-stone-50">
          Abu Shaikh Nibir
        </h1>
        <p class="mt-2.5 text-stone-700 dark:text-stone-300 text-base sm:text-lg leading-relaxed">
          Researcher &amp; Software Engineer. Machine learning, multi-agent systems, and web engineering.<span class="terminal-cursor" aria-hidden="true"></span>
        </p>
      </div>

      <!-- Location line -->
      <div class="flex items-center justify-center sm:justify-start gap-1.5 text-xs sm:text-sm font-mono text-stone-500 dark:text-stone-400">
        <svg class="w-4 h-4 text-teal-600 dark:text-teal-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Dhaka, Bangladesh</span>
      </div>

      <!-- Icon-link row & View / Download CV button -->
      <div class="pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-3 sm:gap-3.5">
        <!-- Email -->
        <a
          href="mailto:abushaikhnibir@gmail.com"
          class="p-2.5 text-stone-600 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 hover:bg-stone-200/60 dark:hover:bg-stone-800/60 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
          aria-label="Send Email to Abu Shaikh Nibir"
          title="Email: abushaikhnibir@gmail.com"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/asnibir"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 text-stone-600 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 hover:bg-stone-200/60 dark:hover:bg-stone-800/60 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
          aria-label="GitHub Profile (opens in new tab)"
          title="GitHub: asnibir"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/abu-shaikh-nibir/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 text-stone-600 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 hover:bg-stone-200/60 dark:hover:bg-stone-800/60 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
          aria-label="LinkedIn Profile (opens in new tab)"
          title="LinkedIn: abu-shaikh-nibir"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
          </svg>
        </a>

        <!-- Google Scholar (Placeholder with TODO comment) -->
        <!-- TODO: Replace href with your Google Scholar profile URL -->
        <a
          href="https://scholar.google.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 text-stone-600 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 hover:bg-stone-200/60 dark:hover:bg-stone-800/60 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
          aria-label="Google Scholar Profile (opens in new tab - TODO: set URL)"
          title="Google Scholar (TODO: update link)"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z" />
          </svg>
        </a>

        <!-- ORCID (Placeholder with TODO comment) -->
        <!-- TODO: Replace href with your ORCID profile URL -->
        <a
          href="https://orcid.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 text-stone-600 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 hover:bg-stone-200/60 dark:hover:bg-stone-800/60 rounded-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
          aria-label="ORCID Profile (opens in new tab - TODO: set URL)"
          title="ORCID (TODO: update link)"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 8.625h2.244c2.459 0 3.869-1.428 3.869-3.6 0-1.928-1.288-3.61-3.791-3.61h-2.322v7.21z" />
          </svg>
        </a>

        <!-- View / Download CV Button (opens PDF viewer modal) -->
        <button
          type="button"
          class="open-cv-modal-btn inline-flex items-center gap-2 px-4 py-2 font-mono text-xs sm:text-sm font-medium rounded-md border border-teal-600/30 dark:border-teal-400/30 text-teal-700 dark:text-teal-300 bg-teal-50/60 dark:bg-teal-950/40 hover:bg-teal-100 dark:hover:bg-teal-900/50 hover:border-teal-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 shadow-sm cursor-pointer"
          aria-haspopup="dialog"
          aria-controls="cv-modal"
          title="Preview and download CV"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          <span>View CV</span>
        </button>
      </div>
    </div>
  </div>
</section>
