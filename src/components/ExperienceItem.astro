---
// ExperienceItem.astro
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
  experience: CollectionEntry<'experience'>;
}

const { experience } = Astro.props;
const { data } = experience;
---

<article class="p-5 rounded-lg border border-stone-200/90 dark:border-stone-800/90 bg-stone-50/50 dark:bg-stone-900/40 hover:border-teal-500/40 dark:hover:border-teal-500/40 transition-colors space-y-3">
  <!-- Role & Company -->
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
    <div>
      <h3 class="text-base sm:text-lg font-semibold text-stone-900 dark:text-stone-100">
        {data.role}
      </h3>
      <p class="text-sm font-medium text-teal-700 dark:text-teal-300">
        {data.company}
      </p>
    </div>
    <div class="text-left sm:text-right font-mono text-xs text-stone-500 dark:text-stone-400 shrink-0">
      <div>{data.startDate} — {data.endDate}</div>
      <div>{data.location}</div>
    </div>
  </div>

  <!-- Impact Bullets -->
  <ul class="space-y-2 text-xs sm:text-sm text-stone-700 dark:text-stone-300 list-disc list-outside pl-4 marker:text-teal-500">
    {data.bullets.map((bullet) => (
      <li class="leading-relaxed">{bullet}</li>
    ))}
  </ul>

  <!-- Tech tags -->
  <div class="pt-2">
    <TagList tags={data.tags} />
  </div>
</article>
