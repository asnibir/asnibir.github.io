---
// TagList.astro
interface Props {
  tags: string[];
  class?: string;
  variant?: 'default' | 'accent';
}

const { tags, class: className = '', variant = 'default' } = Astro.props;
---

<div class={`flex flex-wrap gap-2 ${className}`}>
  {tags.map((tag) => (
    <span
      class={`font-mono text-xs px-2.5 py-1 rounded-md transition-colors ${
        variant === 'accent'
          ? 'bg-teal-50 dark:bg-teal-950/50 text-teal-700 dark:text-teal-300 border border-teal-200/80 dark:border-teal-800/80'
          : 'bg-stone-100 dark:bg-stone-900 text-stone-700 dark:text-stone-300 border border-stone-200 dark:border-stone-800 hover:border-stone-300 dark:hover:border-stone-700'
      }`}
    >
      {tag}
    </span>
  ))}
</div>
