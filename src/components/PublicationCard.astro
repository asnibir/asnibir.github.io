---
// PublicationCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { data } = publication;

// Formatter to render authors with "Abu Shaikh Nibir" in bold
const authorsFormatted = data.authors;
---

<article class="p-5 rounded-lg border border-stone-200/90 dark:border-stone-800/90 bg-stone-50/50 dark:bg-stone-900/40 hover:border-teal-500/40 dark:hover:border-teal-500/40 transition-colors space-y-3">
  <!-- Title -->
  <h3 class="text-base sm:text-lg font-semibold text-stone-900 dark:text-stone-100 leading-snug">
    <a
      href={data.doi}
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-teal-600 dark:hover:text-teal-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 rounded"
    >
      {data.title}
    </a>
  </h3>

  <!-- Authors list -->
  <p class="text-xs sm:text-sm text-stone-700 dark:text-stone-300 leading-relaxed">
    {authorsFormatted.map((author, index) => {
      const isTargetAuthor = author.toLowerCase().includes('abu shaikh nibir');
      return (
        <span>
          {isTargetAuthor ? (
            <strong class="font-bold text-stone-950 dark:text-stone-50 underline decoration-teal-500/60 underline-offset-2">
              {author}
            </strong>
          ) : (
            author
          )}
          {index < authorsFormatted.length - 1 ? ', ' : ''}
        </span>
      );
    })}
  </p>

  <!-- Venue, Volume, Year -->
  <div class="font-mono text-xs text-stone-500 dark:text-stone-400 flex flex-wrap items-center gap-x-2 gap-y-1">
    <span class="font-semibold text-teal-700 dark:text-teal-300 italic">{data.venue}</span>
    {data.publisher && <span>({data.publisher})</span>}
    {data.volume && <span>vol. {data.volume}</span>}
    {data.pages && <span>p. {data.pages}</span>}
    <span>· {data.year}</span>
  </div>

  <!-- Action Buttons: DOI, BibTeX (copy), Abstract (expandable) -->
  <div class="pt-2 flex flex-wrap items-center gap-2 font-mono text-xs">
    <!-- DOI Link Button -->
    <a
      href={data.doi}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-stone-200/70 dark:bg-stone-800 text-stone-800 dark:text-stone-200 hover:bg-teal-600 hover:text-white dark:hover:bg-teal-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
      <span>DOI</span>
    </a>

    <!-- BibTeX Copy Button -->
    <button
      type="button"
      data-bibtex={data.bibtex}
      class="bibtex-copy-btn inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-stone-200/70 dark:bg-stone-800 text-stone-800 dark:text-stone-200 hover:bg-stone-300 dark:hover:bg-stone-700 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500"
      aria-label="Copy BibTeX citation to clipboard"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <span class="btn-text">BibTeX</span>
    </button>

    <!-- Expandable Abstract Accordion -->
    <details class="w-full mt-2 group border-t border-stone-200 dark:border-stone-800 pt-2">
      <summary class="cursor-pointer inline-flex items-center gap-1 text-xs text-stone-600 dark:text-stone-400 hover:text-teal-600 dark:hover:text-teal-400 select-none focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-teal-500 rounded py-0.5">
        <span class="font-semibold group-open:text-teal-600 dark:group-open:text-teal-400">Abstract</span>
        <svg class="w-3.5 h-3.5 transform transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="mt-2 text-xs text-stone-700 dark:text-stone-300 font-sans leading-relaxed p-3 bg-stone-100/70 dark:bg-stone-900/60 rounded border border-stone-200 dark:border-stone-800">
        <p>{data.abstract}</p>
      </div>
    </details>
  </div>
</article>

<script>
  function setupBibtexButtons() {
    const buttons = document.querySelectorAll('.bibtex-copy-btn');
    buttons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const bibtex = btn.getAttribute('data-bibtex');
        if (!bibtex) return;
        const textSpan = btn.querySelector('.btn-text');
        try {
          await navigator.clipboard.writeText(bibtex.trim());
          if (textSpan) {
            const originalText = textSpan.textContent;
            textSpan.textContent = 'Copied!';
            btn.classList.add('text-teal-600', 'dark:text-teal-400', 'font-bold');
            setTimeout(() => {
              textSpan.textContent = originalText;
              btn.classList.remove('text-teal-600', 'dark:text-teal-400', 'font-bold');
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy bibtex: ', err);
        }
      });
    });
  }

  setupBibtexButtons();
  document.addEventListener('astro:after-swap', setupBibtexButtons);
</script>

